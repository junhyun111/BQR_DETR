COCO_ROOT=/mnt/nvme/coco
OUTPUT_ROOT=/mnt/nvme/experiments/dqr-coco
TORCH_CACHE=/mnt/nvme/cache/torch

PYTORCH_IMAGE=pytorch/pytorch:2.1.2-cuda12.1-cudnn8-devel
TORCH_CUDA_ARCH_LIST=8.9
GPU_IDS=8,9
NPROC_PER_NODE=2

METHOD=bqr_dn_v2
RUN_NAME=
EPOCHS=12
BATCH_SIZE=2
ACCUMULATION_STEPS=4
TARGET_GLOBAL_BATCH_SIZE=16
EVAL_BATCH_SIZE=2
NUM_WORKERS=8
PRECISION=fp16
INFERENCE_PRECISION=fp16
DIAGNOSTICS_EVERY=100
SEED=42
RESUME=auto
CHECKPOINT=
